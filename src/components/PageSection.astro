---
import { getEmDashCollection, sanitizeHref } from "emdash";
import { Image, PortableText, type BlockComponentProps } from "emdash/ui";
import type { PageLayoutBlock } from "../../emdash-env";
import PostCard from "./PostCard.astro";
import UpcomingEvents from "./UpcomingEvents.astro";
import HangoutCollage from "./HangoutCollage.astro";
import CommunityStage from "./CommunityStage.astro";
import { recapSpeakers } from "../utils/recap";
import HomeHero from "./HomeHero.astro";
import PodcastSection from "./PodcastSection.astro";

type Props = BlockComponentProps<PageLayoutBlock>;
const { value, index } = Astro.props;
const Heading = value._type === "page_hero" && index === 0 ? "h1" : "h2";
const headingId = `section-${value._key}`;
const link =
	"link_url" in value && value.link_url
		? sanitizeHref(value.link_url)
		: undefined;
const label = "link_label" in value ? value.link_label : undefined;
const surface = "surface" in value && value.surface;
const posts =
	value._type === "page_posts"
		? await getEmDashCollection("posts", {
				orderBy: { event_date: "desc" },
				...(value.category ? { where: { category: value.category } } : {}),
				limit: Math.max(1, Math.min(12, value.count ?? 3)),
			})
		: undefined;
if (posts && Astro.cache?.enabled) Astro.cache.set(posts.cacheHint);
const programmes =
	value._type === "page_cta" && value.anchor === "events"
		? await getEmDashCollection("programmes", {
				orderBy: { sort_order: "asc" },
				limit: 12,
			})
		: undefined;
if (programmes && Astro.cache?.enabled) Astro.cache.set(programmes.cacheHint);
const room = value._type === "page_posts" && value.anchor === "summaries";
const speakerSlugs = room
	? [
			...new Set(
				posts?.entries.flatMap((post) =>
					recapSpeakers(post.data.content).map(
						(speaker) => speaker.href.split("#")[1],
					),
				),
			),
		]
	: [];
const members = speakerSlugs.length
	? await getEmDashCollection("members", {
			where: { slug: speakerSlugs },
			limit: speakerSlugs.length,
		})
	: undefined;
if (members && Astro.cache?.enabled) Astro.cache.set(members.cacheHint);
const community =
	value._type === "page_images" &&
	value.layout === "collage" &&
	value._key === "supper";
const communityPosts = community
	? await getEmDashCollection("posts", {
			where: { category: "event-summaries" },
			orderBy: { event_date: "desc" },
			limit: 2,
		})
	: undefined;
if (communityPosts && Astro.cache?.enabled)
	Astro.cache.set(communityPosts.cacheHint);
const communityPhotos =
	community && value._type === "page_images"
		? [
				{
					image: communityPosts?.entries[0]?.data.featured_image,
					caption: "A build on the table.",
				},
				{ image: value.images?.[0]?.image, caption: "A seat at the table." },
				{
					image: communityPosts?.entries[1]?.data.featured_image,
					caption: "Better questions.",
				},
				{ image: value.images?.[1]?.image, caption: "One more conversation." },
			].flatMap((photo) =>
				photo.image ? [{ image: photo.image, caption: photo.caption }] : [],
			)
		: [];
const valueIllustrations = ["laptop", "stack", "question", "mug"];
---

{
	value._type === "page_hero" && Astro.url.pathname === "/" ? (
		<HomeHero
			heading={value.heading}
			intro={value.intro}
			code={value.code}
			codeTitle={value.code_title}
		/>
	) : (
		<section
			id={value.anchor || (community ? "community" : undefined)}
			class:list={[
				"page-section",
				value._type,
				{
					section: value._type !== "page_hero",
					surface,
					"community-section": community,
					"room-section": room,
					"values-section":
						value._type === "page_items" && value.anchor === "about",
					"audience-section":
						value._type === "page_items" && value.anchor === "audience",
					"podcast-section": value.anchor === "podcast",
					"closing-section": value.anchor === "closing",
				},
			]}
			aria-labelledby={value.heading ? headingId : undefined}
		>
			<div class="container">
				{value._type === "page_hero" ? (
					<div
						class:list={[
							"hero",
							{ "hero-with-visual": value.image || value.code },
						]}
					>
						<div class="hero-copy">
							<Heading id={headingId}>{value.heading}</Heading>
							{value.intro && <p class="hero-intro">{value.intro}</p>}
							<div class="hero-actions">
								{link && label && (
									<a class="button" href={link}>
										{label} <span aria-hidden="true">↗</span>
									</a>
								)}
								{value.secondary_url && value.secondary_label && (
									<a class="text-link" href={sanitizeHref(value.secondary_url)}>
										{value.secondary_label} <span aria-hidden="true">↓</span>
									</a>
								)}
							</div>
							{value.note && (
								<p class="hero-note">
									<span aria-hidden="true">&gt;</span> {value.note}
								</p>
							)}
						</div>
						{value.image ? (
							<div class="hero-visual">
								<Image image={value.image} loading="eager" />
							</div>
						) : (
							value.code && (
								<div class="hero-visual">
									<div class="terminal">
										{value.code_title && (
											<div class="terminal-bar">{value.code_title}</div>
										)}
										<pre>
											<code>{value.code}</code>
										</pre>
									</div>
								</div>
							)
						)}
					</div>
				) : value._type === "page_text" ? (
					<div class="prose">
						{value.heading && <h2 id={headingId}>{value.heading}</h2>}
						<PortableText value={value.body} />
					</div>
				) : value._type === "page_items" ? (
					<>
						<div class="section-heading">
							{value.heading && <h2 id={headingId}>{value.heading}</h2>}
							{value.intro && <p>{value.intro}</p>}
						</div>
						<div
							class:list={[
								"items",
								value.layout === "columns" ? "columns" : "rows",
								{
									values: value.anchor === "about",
									audience: value.anchor === "audience",
								},
							]}
						>
							{value.items?.map((item, i) => (
								<article>
									<h3>{item.title}</h3>
									{value.anchor === "about" && valueIllustrations[i] && (
										<img
											class="value-illustration"
											src={`/images/community/${valueIllustrations[i]}-dimensional.png`}
											width="128"
											height="128"
											alt=""
											loading="lazy"
										/>
									)}
									{item.description && <p>{item.description}</p>}
								</article>
							))}
						</div>
						{link && label && (
							<a class="text-link section-link" href={link}>
								{label} <span aria-hidden="true">↗</span>
							</a>
						)}
					</>
				) : value._type === "page_images" ? (
					community ? (
						<CommunityStage photos={communityPhotos}>
							{value.heading && (
								<h2 id={headingId}>
									{value.heading.split("\n")[0]}
									<br />
									<span>{value.heading.split("\n").slice(1).join(" ")}</span>
								</h2>
							)}
							{value.intro && <p>{value.intro}</p>}
							{link && label && (
								<a class="text-link" href={link}>
									{label}
								</a>
							)}
						</CommunityStage>
					) : value.layout === "collage" ? (
						<div class="photo-stage">
							<div class="stage-copy">
								{value.heading && <h2 id={headingId}>{value.heading}</h2>}
								{value.intro && <p>{value.intro}</p>}
								{link && label && (
									<a class="text-link" href={link}>
										{label} <span aria-hidden="true">↗</span>
									</a>
								)}
							</div>
							{(value.images?.length ?? 0) > 0 && (
								<HangoutCollage
									images={(value.images ?? [])
										.map((item) => item.image)
										.filter(Boolean)}
								/>
							)}
						</div>
					) : (
						<div
							class:list={[
								"image-section",
								{
									split: value.layout === "left" || value.layout === "right",
									"image-left": value.layout === "left",
								},
							]}
						>
							<div class="image-copy">
								{value.heading && <h2 id={headingId}>{value.heading}</h2>}
								{value.intro && <p>{value.intro}</p>}
								{link && label && (
									<a class="text-link" href={link}>
										{label} <span aria-hidden="true">↗</span>
									</a>
								)}
							</div>
							{(value.images?.length ?? 0) > 0 && (
								<div class="images">
									{value.images?.map(
										(item) =>
											item.image && <Image image={item.image} loading="lazy" />,
									)}
								</div>
							)}
						</div>
					)
				) : value._type === "page_cta" &&
				  value.anchor === "events" &&
				  programmes ? (
					<>
						<div class="section-heading">
							{value.heading && <h2 id={headingId}>{value.heading}</h2>}
							{value.intro && <p>{value.intro}</p>}
						</div>
						<div class="formats-grid">
							{programmes.entries.map((programme) => (
								<article class="format-card">
									{programme.data.cover && (
										<a
											class="format-art"
											href={sanitizeHref(programme.data.url || "/events")}
											aria-label={programme.data.title}
										>
											<Image image={programme.data.cover} loading="lazy" />
										</a>
									)}
									<div class="format-copy">
										<h3>{programme.data.title}</h3>
										{programme.data.description && (
											<p>{programme.data.description}</p>
										)}
									</div>
								</article>
							))}
						</div>
						{link && label && (
							<a class="text-link section-link" href={link}>
								{label} <span aria-hidden="true">↗</span>
							</a>
						)}
					</>
				) : value._type === "page_cta" && value.anchor === "closing" ? (
					<>
						<div class="section-heading">
							{value.heading && <h2 id={headingId}>{value.heading}</h2>}
							{value.note && <p>{value.note}</p>}
						</div>
						<UpcomingEvents />
						{link && label && (
							<a class="text-link section-link" href={link}>
								{label} <span aria-hidden="true">↗</span>
							</a>
						)}
					</>
				) : value._type === "page_cta" && value.anchor === "podcast" ? (
					<PodcastSection />
				) : value._type === "page_cta" ? (
					<div class:list={["cta", { split: value.layout === "split" }]}>
						<div>
							{value.heading && <h2 id={headingId}>{value.heading}</h2>}
							{value.note && <p class="cta-note">{value.note}</p>}
						</div>
						<div class="cta-copy">
							{value.intro && <p>{value.intro}</p>}
							{link && label && (
								<a
									class:list={[
										"button",
										{ secondary: value.layout === "split" },
									]}
									href={link}
								>
									{label} <span aria-hidden="true">↗</span>
								</a>
							)}
						</div>
					</div>
				) : value._type === "page_posts" ? (
					<>
						<div class="section-heading">
							{value.heading && <h2 id={headingId}>{value.heading}</h2>}
							{link && label && (
								<a class="text-link" href={link}>
									{label} <span aria-hidden="true">↗</span>
								</a>
							)}
						</div>
						<div class:list={["card-grid", { "room-grid": room }]}>
							{posts?.entries.map((post) => (
								<PostCard
									post={post}
									heading="h3"
									room={room}
									members={members?.entries.map((member) => member.data)}
								/>
							))}
						</div>
						{posts?.entries.length === 0 && <p>No posts published yet.</p>}
					</>
				) : (
					value._type === "page_events" && (
						<>
							<div class="section-heading">
								{value.heading && <h2 id={headingId}>{value.heading}</h2>}
								<div>
									{value.intro && <p>{value.intro}</p>}
									{link && label && (
										<a class="text-link section-link" href={link}>
											{label} <span aria-hidden="true">↗</span>
										</a>
									)}
								</div>
							</div>
							<UpcomingEvents />
							{value.note && <p class="calendar-note">{value.note}</p>}
						</>
					)
				)}
			</div>
		</section>
	)
}

<style>
	.page-section h1,
	.page-section h2 {
		white-space: pre-line;
		overflow-wrap: anywhere;
	}
	.surface {
		background: var(--surface);
	}
	.page_cta:has(.formats-grid) {
		background: var(--bg);
	}
	.hero {
		padding-block: 90px 76px;
	}
	.hero-with-visual {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: 70px;
		align-items: center;
	}
	.hero h1,
	.hero h2 {
		margin: 26px 0;
		max-width: 570px;
	}
	.hero-intro {
		font-size: 17px;
		max-width: 490px;
	}
	.hero-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 28px;
		margin-top: 32px;
	}
	.hero-actions:empty {
		display: none;
	}
	.hero-note {
		font-size: 14px;
		margin-top: 32px;
		max-width: 440px;
	}
	.hero-note span {
		color: var(--orange);
		margin-right: 8px;
	}
	.hero-visual {
		min-width: 0;
		padding: 16px 0;
	}
	.hero-visual :global(img),
	.images :global(img) {
		width: 100%;
		height: auto;
		border-radius: 12px;
	}
	.terminal {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 12px;
		overflow: hidden;
	}
	.terminal-bar {
		padding: 15px 24px;
		border-bottom: 1px solid var(--border);
		font-family: var(--mono);
		font-size: 14px;
		color: var(--secondary);
	}
	pre {
		padding: 30px 24px;
		margin: 0;
		font-family: var(--mono);
		font-size: 14px;
		line-height: 1.9;
		overflow-x: auto;
	}
	.items h3 {
		font-size: 20px;
	}
	.items p {
		font-size: 16px;
		max-width: 680px;
	}
	.rows article {
		display: grid;
		grid-template-columns: 230px 1fr;
		gap: 36px;
		padding-block: 26px;
		border-top: 1px solid var(--border);
	}
	.columns {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 32px 64px;
	}
	.columns article {
		border-top: 1px solid var(--border);
		padding-top: 24px;
	}
	.columns h3 {
		margin-bottom: 12px;
	}
	.values-section .section-heading {
		flex-direction: column;
		align-items: start;
		gap: 20px;
		margin-bottom: 40px;
	}
	.values-section .section-heading > p {
		max-width: 660px;
		font-size: 16px;
	}
	.values.columns {
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 20px;
	}
	.values article,
	.audience article {
		--card-start: #fff3df;
		--card-end: #f9d2bd;
		--edge-start: #d89869;
		--edge-end: #e6c9ad;
		border: 1px solid transparent;
		background:
			linear-gradient(135deg, var(--card-start), var(--card-end)) padding-box,
			linear-gradient(135deg, var(--edge-start), var(--edge-end)) border-box;
		box-shadow: inset 0 1px 0 #ffffff38;
		border-radius: 20px;
	}
	.values article {
		--card-start: #152331;
		--card-end: #633c2b;
		min-width: 0;
		padding: 24px;
		color: #fcf8ee;
		border-color: #ffffff30;
		background: linear-gradient(135deg, var(--card-start), var(--card-end));
	}
	.values article:nth-child(2) {
		--card-start: #19242d;
		--card-end: #69452c;
	}
	.values article:nth-child(3) {
		--card-start: #20232b;
		--card-end: #70402d;
	}
	.values article:nth-child(4) {
		--card-start: #242329;
		--card-end: #6c4830;
	}
	.audience article:nth-child(2) {
		--card-start: #fff2c9;
		--card-end: #f0e5cc;
		--edge-start: #c7a269;
		--edge-end: #d9ceb4;
	}
	.audience article:nth-child(3) {
		--card-start: #f9d6d2;
		--card-end: #ffe6c9;
		--edge-start: #d48c83;
		--edge-end: #e3ba94;
	}
	.audience article:nth-child(4) {
		--card-start: #def0d5;
		--card-end: #f6edcb;
		--edge-start: #9ebd92;
		--edge-end: #d5c799;
	}
	.values h3 {
		color: inherit;
		font-size: 22px;
		line-height: 1.3;
		white-space: pre-line;
		min-height: 3.9em;
		margin-bottom: 0;
	}
	.values p {
		max-width: 48ch;
		color: inherit;
		line-height: 1.6;
	}
	.value-illustration {
		display: block;
		width: 128px;
		height: 128px;
		object-fit: contain;
		margin-block: 24px;
	}
	.community-section {
		padding-block: 64px 40px;
		overflow: hidden;
	}
	.community-section h2 {
		font-size: clamp(30px, 3vw, 42px);
		line-height: 1.2;
	}
	.community-section h2 span {
		color: var(--accent);
	}
	.community-section p {
		margin-block: 20px;
		font-size: 16px;
		white-space: pre-line;
	}
	.community-section .text-link {
		color: var(--accent);
		font-size: 16px;
		font-weight: 500;
		text-decoration: underline;
		text-underline-offset: 5px;
	}
	.room-section .section-heading {
		align-items: start;
		flex-direction: column;
		gap: 20px;
		margin-bottom: 40px;
	}
	.room-section .section-heading .text-link {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 5px;
	}
	.room-section .section-heading .text-link span {
		display: none;
	}
	.audience-section {
		padding-top: 0;
	}
	.audience-section .section-heading {
		flex-direction: column;
		align-items: start;
	}
	.audience-section .section-heading p {
		max-width: 760px;
	}
	.audience.columns {
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 20px;
	}
	.audience article {
		padding: 28px;
	}
	:global([data-theme="dark"]) .audience article {
		--card-start: #152331;
		--card-end: #000;
		--edge-start: #ffffff30;
		--edge-end: #ffffff0d;
		box-shadow: inset 0 1px 0 #ffffff08;
	}
	.audience h3 {
		font-size: 22px;
		line-height: 1.3;
		min-height: 2.6em;
		margin-bottom: 16px;
		text-wrap: initial;
	}
	.audience p {
		font-size: 16px;
	}
	.formats-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
	}
	.format-card {
		min-width: 0;
		border: 1px solid var(--border);
		border-radius: 16px;
		overflow: hidden;
		background: var(--surface);
		display: flex;
		flex-direction: column;
	}
	:global([data-theme="dark"]) .format-card {
		background: linear-gradient(135deg, #152331, #000);
		border-color: #ffffff30;
	}
	.format-art {
		display: block;
		aspect-ratio: 1.25;
		overflow: hidden;
		background: #000;
	}
	.format-art :global(img) {
		width: 100%;
		height: 100%;
		object-fit: contain;
		transition: transform 0.25s;
	}
	.format-card:hover .format-art :global(img) {
		transform: scale(1.03);
	}
	.format-copy {
		padding: 28px;
		display: flex;
		flex-direction: column;
		flex: 1;
	}
	.format-copy h3 {
		font-size: 28px;
		line-height: 1.2;
		margin-bottom: 18px;
	}
	.format-copy p {
		font-size: 16px;
		margin-bottom: 20px;
	}
	.format-copy .text-link {
		margin-top: auto;
		font-weight: 600;
		min-height: 44px;
	}
	.podcast-section {
		background: var(--surface);
		padding-block: 96px;
	}
	:global([data-theme="dark"]) .podcast-section {
		background: linear-gradient(135deg, #152331, #000);
	}
	.photo-stage {
		padding: 0 clamp(0px, 3vw, 32px) 8px;
	}
	.stage-copy {
		max-width: 650px;
		margin-inline: auto;
		text-align: center;
	}
	.stage-copy h2 {
		margin-bottom: 18px;
	}
	.stage-copy p {
		max-width: 440px;
		margin: 0 auto 26px;
	}
	.section-link {
		margin-top: 32px;
	}
	.split {
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 64px;
		align-items: start;
	}
	.split > * {
		min-width: 0;
	}
	.image-left .image-copy {
		order: 2;
	}

---
import { Image } from "emdash/ui";
import type { Member, Post } from "../../emdash-env";
import { recapSpeakers, recapTitle } from "../utils/recap";
import SpeakerAvatars from "./SpeakerAvatars.astro";
interface Props {
	post: {
		id: string;
		data: Post;
		edit: Record<string, Record<string, string>>;
	};
	heading?: "h2" | "h3";
	room?: boolean;
	members?: Member[];
}
const {
	post,
	heading: Heading = "h2",
	room = false,
	members = [],
} = Astro.props;
const dateValue = post.data.event_date || post.data.publishedAt;
const date = dateValue ? new Date(dateValue) : null;
const { title } = recapTitle(post.data.title);
const speakers = recapSpeakers(post.data.content ?? []);
const excerpt = room
	? post.data.excerpt?.replace(/\s*This recap preserves .*$/, "")
	: post.data.excerpt;
---

<article class:list={["post-card", { "room-card": room }]}>
	<div class="post-copy">
		<p class="metadata">
			{
				date ? (
					<time datetime={date.toISOString()}>
						{date.toLocaleDateString("en-SG", {
							day: "numeric",
							month: "short",
							year: "numeric",
							timeZone: "Asia/Singapore",
						})}
					</time>
				) : (
					"From the community"
				)
			}
		</p>
		<Heading {...post.edit.title}
			><a href={`/posts/${post.id}`}>{title}</a></Heading
		>
		{
			post.data.featured_image && (
				<a
					class="post-image"
					href={`/posts/${post.id}`}
					aria-label={`Read ${title}`}
					{...post.edit.featured_image}
				>
					<Image image={post.data.featured_image} />
				</a>
			)
		}
		{excerpt && <p {...post.edit.excerpt}>{excerpt}</p>}
		{
			speakers.length > 0 &&
				(room ? (
					<SpeakerAvatars speakers={speakers} members={members} />
				) : (
					<p class="speaker-credit">
						<span>Speakers</span>
						{speakers.map((speaker) => (
							<a href={speaker.href}>{speaker.name}</a>
						))}
					</p>
				))
		}
		<a class="text-link" href={`/posts/${post.id}`}
			>Read the post <span aria-hidden="true">↗</span></a
		>
	</div>
</article>

<style>
	.room-card {
		padding: 30px;
		border: 1px solid transparent;
		border-radius: 8px;
		background: var(--raised);
	}
	:global([data-theme="dark"]) .room-card {
		border-color: #ffffff30;
		background: linear-gradient(135deg, #152331, #000);
	}
	.room-card .post-copy {
		padding: 0;
	}
	.room-card .metadata {
		margin-bottom: 14px;
	}
	.room-card :is(h2, h3) {
		min-height: 2.5em;
		margin: 0 0 20px;
		font-size: 32px;
		line-height: 1.25;
	}
	.room-card .post-image {
		margin: 0 0 24px;
		border-radius: 6px;
	}
	.room-card .post-copy > p:not(.metadata) {
		margin: 0 0 22px;
		font-size: 16px;
	}
	.room-card :global(.room-speaker-credit) {
		margin-top: auto;
	}
	.room-card .text-link {
		min-height: 44px;
		margin-top: 18px;
		color: var(--accent);
		font-size: 14px;
		text-decoration: underline;
		text-underline-offset: 5px;
	}
	.room-card .text-link span {
		display: none;
	}
	@media (max-width: 1100px) {
		.room-card {
			padding: 24px;
		}
		.room-card :is(h2, h3) {
			font-size: 28px;
		}
	}
</style>

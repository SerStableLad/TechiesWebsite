---
import type { AudienceChart } from "../utils/recap";
interface Props {
	node: { charts: AudienceChart[] };
}
const { node } = Astro.props;
---

<div class="audience-charts">
	{
		node.charts.map((chart) => (
			<figure class="audience-chart">
				<h3>{chart.title}</h3>
				<ul class="chart-bars">
					{[...chart.items]
						.sort((a, b) => b.value - a.value)
						.map((item) => (
							<li>
								<span class="bar-label">{item.label}</span>
								<strong class="bar-value">{item.value}%</strong>
								<span class="bar-track" aria-hidden="true">
									<span class="bar-fill" style={`width:${item.value}%`} />
								</span>
							</li>
						))}
				</ul>
			</figure>
		))
	}
</div>
<p class="chart-rounding">
	Percentages are shown as reported; totals may differ slightly from 100% due to
	rounding.
</p>
<style>
	.audience-charts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 40px;
		margin-bottom: 24px;
	}
	.audience-chart {
		min-width: 0;
	}
	.audience-chart h3 {
		font-size: 22px;
		line-height: 1.3;
		margin: 0 0 20px;
		padding: 0;
	}
	.chart-bars {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.chart-bars li {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: baseline;
		gap: 4px 12px;
		margin: 0 0 18px;
		font-size: 14px;
		line-height: 1.5;
	}
	.bar-label {
		color: var(--body);
	}
	.bar-value {
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.bar-track {
		grid-column: 1 / -1;
		height: 6px;
		border-radius: 3px;
		background: var(--raised);
	}
	.bar-fill {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--accent);
	}
	.chart-rounding {
		font-size: 13px;
		line-height: 1.5;
		color: var(--muted);
		margin: 20px 0 0;
	}
	.chart-rounding + :global(p) {
		font-size: 13px;
		line-height: 1.5;
		color: var(--muted);
		margin: 2px 0 0;
	}
	@media (max-width: 1100px) and (min-width: 901px) {
		.audience-charts {
			gap: 36px;
		}
	}
	@media (max-width: 640px) {
		.audience-charts {
			gap: 32px;
		}
		.audience-chart h3 {
			font-size: 24px;
		}
		.chart-bars li {
			font-size: 16px;
			max-width: 360px;
		}
	}
</style>

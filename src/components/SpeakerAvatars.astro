---
import { Image } from "emdash/ui";
import type { Member } from "../../emdash-env";
import type { RecapSpeaker } from "../utils/recap";

interface Props {
	speakers: RecapSpeaker[];
	members: Member[];
	byline?: boolean;
}
const { speakers, members, byline = false } = Astro.props;
const profiles = speakers.map((speaker) => {
	const member = members.find(
		(candidate) => candidate.slug === speaker.href.split("#")[1],
	);
	const crop = member?.portrait_crop as
		{ x: number; y: number; size: number } | undefined;
	const cropped =
		crop &&
		[crop.x, crop.y, crop.size].every(Number.isFinite) &&
		crop.x >= 0 &&
		crop.y >= 0 &&
		crop.size > 0 &&
		crop.size <= 1;
	return { ...speaker, member, crop: cropped ? crop : undefined };
});
---

<div class:list={["room-speaker-credit", { byline }]}>
	<div class="avatar-stack">
		{
			profiles.map((profile) => (
				<a href={profile.href} aria-label={`Meet ${profile.name}`}>
					<span
						class:list={["speaker-avatar", { cropped: profile.crop }]}
						style={
							profile.crop
								? `--crop-x:${profile.crop.x};--crop-y:${profile.crop.y};--crop-size:${profile.crop.size}`
								: undefined
						}
					>
						{profile.member?.photo ? (
							<Image
								image={{ ...profile.member.photo, alt: "" }}
								loading="lazy"
							/>
						) : (
							<span aria-hidden="true">
								{profile.name
									.split(" ")
									.slice(0, 2)
									.map((part) => part[0])
									.join("")}
							</span>
						)}
					</span>
					{byline && <span>{profile.name}</span>}
				</a>
			))
		}
	</div>
	{!byline && <span>{speakers.map((speaker) => speaker.name).join(", ")}</span>}
</div>

<style>
	.room-speaker-credit {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 14px;
		line-height: 1.6;
		min-height: 48px;
		color: var(--secondary);
	}
	.avatar-stack {
		display: flex;
		flex-shrink: 0;
		padding-left: 4px;
	}
	.avatar-stack a {
		display: block;
		margin-left: -4px;
		border: 2px solid var(--card);
		border-radius: 50%;
	}
	.speaker-avatar {
		display: grid;
		place-items: center;
		position: relative;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		overflow: hidden;
		background: var(--surface);
		color: var(--text);
	}
	.speaker-avatar :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.cropped :global(img) {
		position: absolute;
		width: calc(100% / var(--crop-size));
		max-width: none;
		height: auto;
		left: calc(-100% * var(--crop-x) / var(--crop-size));
		top: calc(-100% * var(--crop-y) / var(--crop-size));
	}
	.byline .avatar-stack {
		flex-wrap: wrap;
		gap: 10px 24px;
		padding: 0;
	}
	.byline .avatar-stack a {
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 44px;
		margin: 0;
		border: 0;
		border-radius: 0;
		color: var(--accent);
		font-size: 16px;
	}
	.byline .speaker-avatar {
		width: 36px;
		height: 36px;
		flex-shrink: 0;
	}
</style>

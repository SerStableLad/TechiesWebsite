---
import Base from "../../layouts/Base.astro";
import CampaignEntry from "../../components/CampaignEntry";
import { campaignQuery } from "../../plugins/campaigns/public-query";
import type { CampaignSummary, PublicCampaign } from "../../plugins/campaigns/model";
import { decodeSlug } from "emdash";
import { summarize } from "../../utils/seo";
if (Astro.cache?.enabled) Astro.cache.set(false);
Astro.response.headers.set("Cache-Control", "private, no-store");
let campaign: CampaignSummary | PublicCampaign | null;
try { ({ campaign } = await campaignQuery<{ campaign: CampaignSummary | PublicCampaign | null }>(Astro.locals, Astro.url, "detail", { slug: decodeSlug(Astro.params.slug) ?? "" })); }
catch { return new Response("Could not load this campaign. Please try again shortly.", { status: 503 }); }
if (!campaign) return Astro.rewrite("/404");
if (campaign.visibility === "private") Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---
<Base title={campaign.title ?? "Campaign"} description={summarize(campaign.description?.replace(/<[^>]*>/g, " ")) || summarize(campaign.prize)} image={campaign.image} robots={campaign.visibility === "private" ? "noindex, nofollow" : undefined}>
	<CampaignEntry initial={campaign} client:load />
</Base>

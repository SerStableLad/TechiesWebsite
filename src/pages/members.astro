---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import ProfileCard from "../components/ProfileCard.astro";
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries: members, cacheHint, nextCursor } = await getEmDashCollection("members", { orderBy: { sort_order: "asc" }, limit: 24, cursor });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---
<Base title="Member showcase" description="Meet the curious builders in the Techies community. Discover what they’re building and the questions they’re working through.">
  <div class="container page-content">
    <header class="page-heading"><h1>Member showcase</h1><p>Meet the people making the room what it is. Discover what they’re building, what they’re curious about, and where your next conversation might start.</p></header>
    {members.length ? <section class="card-grid" aria-label="Techies member showcase">{members.map(profile => <ProfileCard profile={profile} showcase />)}</section> : <section class="empty-state"><h2>Every build has a person behind it.</h2><p>We’re putting together our first member profiles. In the meantime, meet the community at a session—or get to know the people organising the room.</p><a class="button" href="https://luma.com/APACtechies">Meet us at a session ↗</a><a class="text-link meet-exco" href="/exco">Meet the Exco ↗</a></section>}
    <nav class="pagination" aria-label="Member pagination">{cursor && <a class="text-link" href="/members">First page</a>}{nextCursor && <a class="text-link" href={`/members?cursor=${encodeURIComponent(nextCursor)}`}>More members →</a>}</nav>
  </div>
</Base>
<style>.meet-exco { margin: 18px 0 0 24px; } @media(max-width: 640px) { .meet-exco { display: flex; margin-left: 0; } }</style>

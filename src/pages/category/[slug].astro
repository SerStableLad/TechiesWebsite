---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	decodeSlug,
} from "emdash";
import PostCard from "../../components/PostCard.astro";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base title={`${term.label} posts`} description={`Posts in ${term.label}`}>
	<div class="container page-content">
	<header class="page-heading"><nav aria-label="Back to posts"><a class="back-link" href="/posts">← All posts</a></nav><h1>{term.label}</h1><p>Real conversations, written down. Decisions, constraints, and lessons from the room.</p></header>
	{posts.length ? <div class="card-grid">{posts.map(post => <PostCard post={post} />)}</div> : <p>No posts in this category yet.</p>}
	<nav class="pagination" aria-label="Pagination">
		{cursor && <a href={`/category/${term.slug}`}>First page</a>}
		{
			nextCursor && (
				<a
					href={`/category/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}
				>
					Next page
				</a>
			)
		}
	</nav>
	</div>
</Base>

---
import { getEmDashCollection, getEmDashEntry } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";

const [homeResult, programmeResult, postResult] = await Promise.all([
  getEmDashEntry("pages", "home"),
  getEmDashCollection("programmes", { orderBy: { sort_order: "asc" }, limit: 12 }),
  getEmDashCollection("posts", { orderBy: { event_date: "desc" }, where: { category: "event-summaries" }, limit: 3 }),
]);
if (Astro.cache?.enabled) for (const result of [homeResult, programmeResult, postResult]) Astro.cache.set(result.cacheHint);
const home = homeResult.entry;
---

<Base title="A 3rd space for devs to geek out." description={home?.data.intro}>
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title" {...home?.edit.title}>{home?.data.title || "A 3rd space for devs to geek out."}</h1>
        <p class="hero-intro" {...home?.edit.intro}>{home?.data.intro}</p>
        <div class="hero-actions"><a class="button" href="#upcoming">See upcoming events <span aria-hidden="true">↗</span></a><a class="text-link" href="#about">Get to know us <span aria-hidden="true">↓</span></a></div>
        <p class="hero-note"><span aria-hidden="true">&gt;</span> Depth is the conversation. Not a credential at the door.</p>
      </div>
      <div class="hero-visual">
        <div class="terminal">
          <div class="terminal-bar">community.ts</div>
          <pre is:raw><code><span class="code-keyword">const</span> techies = {
  people: <span class="code-string">"curious builders"</span>,
  bring: [
    <span class="code-string">"your stack"</span>,
    <span class="code-string">"your constraints"</span>,
    <span class="code-string">"better questions"</span>
  ],
  salesPitch: <span class="code-keyword">false</span>,
  supperAfter: <span class="code-keyword">true</span>
};</code></pre>
        </div>
      </div>
    </section>
  </div>

  <section class="section" id="about">
    <div class="container">
      <div class="section-heading"><h2>Go deep.<br />Feel at home.</h2><p {...home?.edit.about_intro}>{home?.data.about_intro}</p></div>
      <div class="pillars">
        <article><h3>Real conversations</h3><p>The working reality, not the polished pitch. Share what you tried, the awkward parts, and the decisions still keeping you up.</p></article>
        <article><h3>Deep technical</h3><p>Architecture, bottlenecks, costs, and trade-offs. We get beyond what a product does and into how—and why—it works.</p></article>
        <article><h3>High intensity</h3><p>Probing questions, engaged discussion, and cheeky energy. Challenge the decision. Be kind to the person who made it.</p></article>
      </div>
    </div>
  </section>

  <section class="section programmes-section" id="events">
    <div class="container">
      <div class="section-heading"><h2>Our events</h2><p>Real stacks, production mistakes, and product decisions. Different formats. The same curiosity.</p></div>
      <div class="programme-grid">
        {programmeResult.entries.map(programme => (
          <article class:list={["programme-card", programme.data.accent]}>
            <a href={programme.data.url} class="programme-image" aria-label={`View ${programme.data.title} on Luma`} {...programme.edit.cover}>{programme.data.cover && <Image image={programme.data.cover} />}</a>
            <div class="programme-copy"><h3 {...programme.edit.title}>{programme.data.title}</h3><p class="programme-label" {...programme.edit.label}>{programme.data.label?.replace(/^\d+\s*\/\s*/, "")}</p><p {...programme.edit.description}>{programme.data.description}</p><a class="text-link" href={programme.data.url}>View the session <span aria-hidden="true">↗</span></a></div>
          </article>
        ))}
      </div>
      <p class="event-note"><strong>Prod is Brewing:</strong> hands-on workshops to compare product choices and engineering trade-offs, before writing code.</p>
    </div>
  </section>

  <section class="section" id="summaries">
    <div class="container">
      <div class="section-heading"><h2>From the room</h2><a class="text-link" href="/posts">All posts & event summaries <span aria-hidden="true">↗</span></a></div>
      <div class="card-grid">{postResult.entries.map(post => <PostCard post={post} heading="h3" />)}</div>
    </div>
  </section>

  <section class="section supper-section">
    <div class="container supper-grid">
      <div class="supper-copy"><h2>Come for the event.<br /><span class="accent">Stay for the company.</span></h2><p {...home?.edit.supper_copy}>{home?.data.supper_copy}</p><a class="text-link" href="/members">Meet the community <span aria-hidden="true">↗</span></a></div>
      <div class="supper-photos"><div class="supper-main" {...home?.edit.supper_photo}>{home?.data.supper_photo && <Image image={home.data.supper_photo} />}</div><div class="supper-second" {...home?.edit.supper_photo_two}>{home?.data.supper_photo_two && <Image image={home.data.supper_photo_two} />}</div><span class="photo-caption">Techies, off the clock.</span></div>
    </div>
  </section>

  <section class="section" id="upcoming">
    <div class="container"><div class="section-heading"><h2>What’s next?</h2><div><p>The live calendar updates when a session is published.</p><a class="text-link calendar-link" href="https://luma.com/APACtechies">Open the Luma calendar <span aria-hidden="true">↗</span></a></div></div><div class="calendar"><iframe src="https://luma.com/embed/calendar/cal-i9QxU3ZODPclPpp/events" width="100%" height="500" title="Upcoming Techies events on Luma" loading="lazy"></iframe></div><p class="calendar-note">Registration and any approval requirements are shown on each event’s Luma page.</p></div>
  </section>

  <section class="section" id="podcast">
    <div class="container podcast-panel"><div><h2>Do You Even Build</h2><p class="podcast-status">On pause · Season 1 complete</p></div><div class="podcast-copy"><p {...home?.edit.podcast_copy}>{home?.data.podcast_copy}</p><a class="button secondary" href={home?.data.podcast_url || "https://open.spotify.com/show/3JhNpERWFXWIjGcmXDvu3f"}>Listen to Season 1 <span aria-hidden="true">↗</span></a></div></div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.15fr 1fr; gap: 70px; padding-block: 90px 76px; align-items: center; }
  .hero h1 { margin: 26px 0; max-width: 570px; }
  .hero-intro { font-size: 17px; max-width: 490px; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 28px; margin-top: 32px; }
  .hero-note { font-size: 14px; margin-top: 32px; max-width: 440px; }
  .hero-note span { color: var(--orange); margin-right: 8px; }
  .hero-visual { position: relative; padding: 16px 0; }
  .terminal { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  .terminal-bar { padding: 15px 24px; border-bottom: 1px solid var(--border); font-family: var(--mono); font-size: 14px; color: var(--secondary); }
  pre { padding: 30px 24px; margin: 0; font-family: var(--mono); font-size: 14px; line-height: 1.9; overflow-x: auto; }
  .terminal :global(.code-keyword) { color: var(--orange); }
  .terminal :global(.code-string) { color: var(--text); }
  .pillars article { display: grid; grid-template-columns: 230px 1fr; gap: 36px; padding-block: 26px; border-top: 1px solid var(--border); }
  .pillars h3 { font-size: 20px; }
  .pillars p { font-size: 16px; max-width: 680px; }
  .programmes-section { background: var(--surface); }
  .programme-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .programme-card { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; --event-accent: var(--orange); display: flex; flex-direction: column; }
  .programme-card.red { --event-accent: var(--red); }
  .programme-image { aspect-ratio: 1; overflow: hidden; }
  .programme-image :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .programme-copy { padding: 26px; display: flex; flex-direction: column; flex: 1; }
  .programme-copy .programme-label { color: var(--event-accent); font-size: 14px; margin-bottom: 18px; }
  .programme-copy h3 { margin: 0 0 12px; line-height: 1.2; }
  .programme-copy > p:not(.programme-label) { font-size: 16px; margin-bottom: 24px; }
  .programme-copy .text-link { margin-top: auto; }
  .event-note { font-size: 14px; max-width: 800px; margin-top: 28px; }
  .supper-section { background: var(--surface); }
  .supper-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; align-items: center; }
  .supper-copy h2 { margin: 22px 0; }
  .supper-copy > p:not(.eyebrow) { margin-bottom: 26px; }
  .supper-photos { position: relative; padding: 0 30px 94px 0; }
  .supper-main { border-radius: 12px; overflow: hidden; aspect-ratio: 4/3; }
  .supper-main :global(img), .supper-second :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .supper-second { position: absolute; width: 49%; right: 0; bottom: 40px; aspect-ratio: 4/3; border: 6px solid var(--surface); border-radius: 12px; overflow: hidden; }
  .photo-caption { position: absolute; bottom: 0; left: 0; font-size: 14px; color: var(--secondary); }
  .calendar { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; overflow: hidden; }
  .calendar iframe { border: 0; display: block; }
  .calendar-link { margin-top: 12px; }
  .calendar-note { margin-top: 16px; font-size: 14px; }
  .podcast-panel { display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; align-items: start; }
  .podcast-status { margin-top: 18px; font-size: 14px; color: var(--secondary); }
  .podcast-copy > p { margin-bottom: 28px; max-width: 560px; }
  @media (max-width: 900px) { .hero { gap: 32px; } .programme-grid { gap: 16px; } .programme-copy { padding: 20px; } .supper-grid { gap: 32px; } .podcast-panel { gap: 40px; } }
  @media (max-width: 700px) { .hero { grid-template-columns: 1fr; padding-block: 50px; gap: 40px; } .hero h1 { max-width: 500px; } .hero-intro { font-size: 16px; } .hero-visual { max-width: 480px; width: 100%; } .pillars article, .programme-grid, .supper-grid, .podcast-panel { grid-template-columns: 1fr; } .pillars article { gap: 14px; } .programme-grid { gap: 28px; } .programme-copy { padding: 26px; } .supper-copy { margin-bottom: 12px; } }
</style>

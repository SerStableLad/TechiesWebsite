---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import ProfileCard from "../components/ProfileCard.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const membersResult = await getEmDashCollection("members", { orderBy: { sort_order: "asc" }, limit: 24, cursor });
if (Astro.cache?.enabled) {
	Astro.cache.set(membersResult.cacheHint);
}
const { entries: members, nextCursor } = membersResult;
if (membersResult.error) {
  return new Response("Unable to load people. Please try again.", { status: 503 });
}
// Keep the pre-merge anchor working while existing draft changes await editorial publication.
const people = members.map(member => ({ ...member, excoRoles: [], aliases: Array.isArray(member.data.legacy_aliases) ? member.data.legacy_aliases as string[] : member.id === "ying-zhao" ? ["yingzhao-ouyang"] : [] }));
---
<Base title="Community Members & Organisers" description="Meet the developers, builders, speakers, and volunteer organisers behind Techies, a community for candid technical conversations across APAC." canonical={`/people${cursor ? `?cursor=${encodeURIComponent(cursor)}` : ""}`}>
  <div class="container page-content">
    <header class="page-heading"><h1>People in <span class="accent">the room.</span></h1><p>Meet the members of Techies. See what they’ve shared, find familiar interests, and get to know the people behind the builds.</p></header>
    <section id="members" aria-label="Techies members">
      <span id="exco" aria-hidden="true"></span>
      {people.length ? <div class="card-grid">{people.map(profile => <ProfileCard profile={profile} />)}</div> : <section class="empty-state"><h2>Every build has a person behind it.</h2><p>We’re putting together our first member profiles. In the meantime, meet the community at a session.</p><a class="button" href="https://luma.com/APACtechies">Meet us at a session ↗</a></section>}
      <nav class="pagination" aria-label="Member pagination">{cursor && <a class="text-link" href="/people#members">First page</a>}{nextCursor && <a class="text-link" href={`/people?cursor=${encodeURIComponent(nextCursor)}#members`}>More members →</a>}</nav>
    </section>
  </div>
</Base>

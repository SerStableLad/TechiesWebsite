---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	decodeSlug,
} from "emdash";
import PostCard from "../../components/PostCard.astro";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base
	title={`Posts tagged "${term.label}"`}
	description={`Posts tagged ${term.label}`}
>
	<div class="container page-content">
	<header class="page-heading"><nav aria-label="Back to posts"><a class="back-link" href="/posts">← All posts</a></nav><h1>{term.label}</h1><p>Follow the decisions and discussions behind this topic.</p></header>
	{posts.length ? <div class="card-grid">{posts.map(post => <PostCard post={post} />)}</div> : <p>No posts with this tag yet.</p>}
	<nav class="pagination" aria-label="Pagination">
		{cursor && <a href={`/tag/${term.slug}`}>First page</a>}
		{
			nextCursor && (
				<a href={`/tag/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}>
					Next page
				</a>
			)
		}
	</nav>
	</div>
</Base>

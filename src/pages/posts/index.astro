---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries: posts, cacheHint, nextCursor } = await getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 12, cursor });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---
<Base title="Event Recaps & Community Updates" description="Read Techies event recaps, real-world engineering trade-offs, and partnership updates from the APAC developer community." canonical={`/posts${cursor ? `?cursor=${encodeURIComponent(cursor)}` : ""}`}>
  <div class="container page-content">
    <header class="page-heading"><h1>Posts</h1><p>Event summaries, engineering trade-offs, and partnership announcements from the Techies community.</p>
    </header>
    {posts.length ? <div class="card-grid">{posts.map(post => <PostCard post={post} />)}</div> : <p>No posts in this category yet.</p>}
    <nav class="pagination" aria-label="Post pagination">{cursor && <a class="text-link" href="/posts">First page</a>}{nextCursor && <a class="text-link" href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>More posts →</a>}</nav>
  </div>
</Base>
